APP_NAME=UrbanSaarthi API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./urbansaarthi.db
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=https://urbansarthi.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.vercel\.app
OSRM_BASE_URL=https://router.project-osrm.org
OPENAQ_API_KEY=
MODEL_PATH=
GTFS_MAX_UPLOAD_MB=30
AUTO_REFRESH_FORECASTS=true
FORECAST_REFRESH_MIN_INTERVAL_SECONDS=300

# Render/PostgreSQL startup safety: run forward-only migrations and seed only if core tables are empty.
AUTO_MIGRATE_ON_STARTUP=true
AUTO_SEED_DEMO_DATA=true
