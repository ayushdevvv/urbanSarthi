APP_NAME=UrbanSaarthi API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./urbansaarthi.db
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional custom OSRM-compatible router. Leave blank to use public OpenStreetMap car/foot/bike routes.
OSRM_BASE_URL=
# Optional legacy station synchronisation key; AQI location forecasts use Open-Meteo and need no key.
OPENAQ_API_KEY=
# Optional: adds provider live traffic flow when a TomTom key and coverage are available.
TOMTOM_API_KEY=
MODEL_PATH=
GTFS_MAX_UPLOAD_MB=30
AUTO_REFRESH_FORECASTS=true
FORECAST_REFRESH_MIN_INTERVAL_SECONDS=300

# Optional override; default is backend/models/best.pt
TRAFFIC_MODEL_PATH=

# Optional: override the shipped multimodal AQI model folder
# AQI_MODEL_DIR=models/aqi
