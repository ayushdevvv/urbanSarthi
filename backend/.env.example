# Core application
APP_NAME="UrbanSaarthi API"
APP_ENV=development
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./urbansaarthi.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Hackathon demo: no human login for citizen or authority pages.
# Device and edge ingestion is still protected by this server-only key.
INGESTION_API_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Road routing. Optional OSRM-compatible router. Without it, routes may be
# distance/time estimates and must not be presented as live navigation.
OSRM_BASE_URL=

# Live data providers (server-side secrets only)
# OpenAQ v3 pollutant observations; does NOT provide official CPCB AQI.
OPENAQ_API_KEY=
# OpenWeather Air Pollution API; 1-5 scale, separately labelled in the UI.
WEATHER_API_KEY=
# TomTom current road-flow snapshots at the selected coordinate.
TOMTOM_API_KEY=

# Forecast / vision models
MODEL_PATH=
TRAFFIC_MODEL_PATH=
# Optional override for the bundled AQI model folder
# AQI_MODEL_DIR=models/aqi

GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional LLM-native tool calling in Traffic Lab.
# Without this key the deterministic tool workflow remains available.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Native SUMO execution. Render installs the official eclipse-sumo Python wheel.
# Leave these blank to let the application discover sumo.SUMO_HOME and its bin/sumo executable.
SUMO_BINARY=
SUMO_HOME=

# Transit upload guard and scheduled forecast refresh behaviour
GTFS_MAX_UPLOAD_MB=30
AUTO_REFRESH_FORECASTS=true
FORECAST_REFRESH_MIN_INTERVAL_SECONDS=300

# Optional live web/news search for citizen traffic and transit intelligence
TAVILY_API_KEY=
