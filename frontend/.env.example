# Base URL includes the /api/v1 prefix.
# Local: http://127.0.0.1:8000/api/v1
# Production default follows the Render service declared in ../render.yaml.
# Override this in Vercel if your Render service has a custom/different URL.
# VITE_API_URL=https://urbansaarthi-api.onrender.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Set true in the production frontend build when the backend uses AUTH_ENABLED=true.
# This protects the authority workspace UI; backend role checks remain authoritative.
VITE_REQUIRE_AUTH=false
