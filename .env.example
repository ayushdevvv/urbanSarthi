# UrbanSaarthi — environment reference for the public hackathon deployment.
# This file is a template only. Never commit real credentials.
# Local backend: copy backend/.env.example to backend/.env.
# Render backend: set backend variables in the Render Environment tab.

# ---------- FastAPI / Render ----------
APP_NAME="UrbanSaarthi API"
APP_ENV=production
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
CORS_ORIGINS=https://urbansarthi.vercel.app

# Human login has intentionally been removed for the public hackathon demo.
# This key protects camera/IoT edge ingestion only. Keep it server-side.
INGESTION_API_KEY=replace-with-a-random-secret-at-least-32-characters-long

# ---------- Live providers (optional) ----------
TOMTOM_API_KEY=

OPENAQ_API_KEY=
WEATHER_API_KEY=
# Google AI Studio API key. Keep server-side; never expose in Vite env.
GEMINI_API_KEY=
GOOGLE_AI_PRIMARY_MODEL=gemini-3.8-flash
GOOGLE_AI_FALLBACK_MODEL=gemma-4-26b-a4b-it
GOOGLE_AI_TIMEOUT_SECONDS=12
OSRM_BASE_URL=

# ---------- Models and simulation ----------
MODEL_PATH=
TRAFFIC_MODEL_PATH=
# Native SUMO is installed from the official eclipse-sumo Python wheel.
# Leave these unset to let the backend discover the bundled binary automatically.
SUMO_BINARY=
SUMO_HOME=

# ---------- Transit / scheduled refresh ----------
GTFS_MAX_UPLOAD_MB=30
AUTO_REFRESH_FORECASTS=true
FORECAST_REFRESH_MIN_INTERVAL_SECONDS=300

# Vercel frontend: use frontend/.env.example and set VITE_API_URL in Vercel.
